{
  "openapi": "3.1.0",
  "info": {
    "title": "Tuma API",
    "description": "Backend API for the Tuma commerce + delivery platform",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "operationId": "health_check",
        "responses": {
          "200": {
            "description": "Server is healthy",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/customers": {
      "get": {
        "tags": [
          "admin"
        ],
        "operationId": "list_customers",
        "responses": {
          "200": {
            "description": "All customer accounts, oldest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MeResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not an admin"
          }
        }
      }
    },
    "/v1/admin/customers/{id}": {
      "delete": {
        "tags": [
          "admin"
        ],
        "summary": "Hard-delete a customer. Permanent — the platform confirms before\ncalling. Scoped to customers: a merchant or admin id is a 404.",
        "operationId": "delete_customer",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Customer user id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Customer deleted"
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not an admin"
          },
          "404": {
            "description": "No customer with that id"
          }
        }
      },
      "patch": {
        "tags": [
          "admin"
        ],
        "summary": "Edit a customer (name, phone, active flag). A taken phone is a 409.",
        "operationId": "update_customer",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Customer user id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCustomerInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The updated customer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not an admin"
          },
          "404": {
            "description": "No customer with that id"
          },
          "409": {
            "description": "Phone already taken"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/v1/admin/merchants": {
      "get": {
        "tags": [
          "admin"
        ],
        "operationId": "list_merchants",
        "responses": {
          "200": {
            "description": "All merchant accounts, oldest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MeResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not an admin"
          }
        }
      },
      "post": {
        "tags": [
          "admin"
        ],
        "operationId": "create_merchant",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMerchantInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Merchant created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not an admin"
          },
          "409": {
            "description": "Email already taken"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/v1/admin/merchants/{id}": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "One merchant account with everything the admin detail page shows: the\naccount itself and their stores with product counts. Admin sees facts;\nthe merchant manages the menu — it stays out of the admin's response.\nUnknown ids and non-merchant ids are the same 404.",
        "operationId": "get_merchant",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Merchant user id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The merchant and their stores",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MerchantDetailResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not an admin"
          },
          "404": {
            "description": "No merchant with that id"
          }
        }
      },
      "delete": {
        "tags": [
          "admin"
        ],
        "summary": "Hard-delete a merchant. Their stores and products follow via ON DELETE\nCASCADE — this is permanent, and the platform confirms before calling.",
        "operationId": "delete_merchant",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Merchant user id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Merchant deleted"
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not an admin"
          },
          "404": {
            "description": "No merchant with that id"
          }
        }
      },
      "patch": {
        "tags": [
          "admin"
        ],
        "summary": "Edit a merchant (name, email, active flag). A taken email is a 409.",
        "operationId": "update_merchant",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Merchant user id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMerchantInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The updated merchant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not an admin"
          },
          "404": {
            "description": "No merchant with that id"
          },
          "409": {
            "description": "Email already taken"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/v1/admin/summary": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Platform-wide counts for the admin dashboard.",
        "operationId": "summary",
        "responses": {
          "200": {
            "description": "Platform-wide counts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminSummaryResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not an admin"
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Merchant/admin sign-in for the platform. Sets the two session cookies\n(15-min access JWT + 30-day opaque refresh); the body is empty.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Session cookies set (tuma-auth-token + tuma-auth-refresh)"
          },
          "401": {
            "description": "One generic error for every failure path"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Logged out"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/v1/auth/otp/request": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "otp_request",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpRequestInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Always the same response — reveals nothing about the phone number",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OtpRequestResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid phone number"
          }
        }
      }
    },
    "/v1/auth/otp/verify": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "otp_verify",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpVerifyInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Code valid — account fetched or created, token issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OtpVerifyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or expired code"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/v1/auth/password": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Change the caller's own password. Merchant/admin only in practice —\ncustomers have no password (OTP accounts), which is a 400.",
        "operationId": "change_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Password changed"
          },
          "400": {
            "description": "Account has no password (OTP sign-in)"
          },
          "401": {
            "description": "Not authenticated, or current password is wrong"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "me",
        "responses": {
          "200": {
            "description": "The authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials"
          }
        }
      },
      "patch": {
        "tags": [
          "auth"
        ],
        "summary": "Updates the caller's own profile. Name is the only mutable field in V1\n(see tuma-docs/Tuma_API_Architecture.md §3). Used by the mobile name\ncapture step: OTP verify consumes the code, so a fresh user's name lands\nhere, not in a second verify call.",
        "operationId": "update_me",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMeInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The updated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Empty name"
          },
          "401": {
            "description": "Missing or invalid credentials"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/v1/merchant/products": {
      "get": {
        "tags": [
          "merchant"
        ],
        "operationId": "list_own_products",
        "responses": {
          "200": {
            "description": "The merchant's full menu, oldest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not a merchant"
          }
        }
      },
      "post": {
        "tags": [
          "merchant"
        ],
        "operationId": "create_product",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProductInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Product added to the menu",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not a merchant"
          },
          "404": {
            "description": "The store_id is not one of this merchant's stores"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/v1/merchant/products/{id}": {
      "delete": {
        "tags": [
          "merchant"
        ],
        "summary": "Hard-delete one of the merchant's products. Permanent — the platform\nconfirms before calling.",
        "operationId": "delete_product",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Product id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Product deleted"
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not a merchant"
          },
          "404": {
            "description": "Not one of this merchant's products"
          }
        }
      },
      "patch": {
        "tags": [
          "merchant"
        ],
        "operationId": "update_product",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Product id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProductInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The updated product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not a merchant"
          },
          "404": {
            "description": "Not one of this merchant's products"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/v1/merchant/stores": {
      "get": {
        "tags": [
          "merchant"
        ],
        "operationId": "list_own_stores",
        "responses": {
          "200": {
            "description": "The merchant's stores, oldest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StoreResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not a merchant"
          }
        }
      },
      "post": {
        "tags": [
          "merchant"
        ],
        "operationId": "create_own_store",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateStoreInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Store created (starts closed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not a merchant"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/v1/merchant/stores/{id}": {
      "get": {
        "tags": [
          "merchant"
        ],
        "operationId": "get_own_store",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Store id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One of the merchant's stores",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not a merchant"
          },
          "404": {
            "description": "Not one of this merchant's stores"
          }
        }
      },
      "delete": {
        "tags": [
          "merchant"
        ],
        "summary": "Hard-delete one of the merchant's stores. Its products follow via\nON DELETE CASCADE — permanent, and the platform confirms before calling.",
        "operationId": "delete_own_store",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Store id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Store deleted"
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not a merchant"
          },
          "404": {
            "description": "Not one of this merchant's stores"
          }
        }
      },
      "patch": {
        "tags": [
          "merchant"
        ],
        "operationId": "update_own_store",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Store id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateStoreInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The updated store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not a merchant"
          },
          "404": {
            "description": "Not one of this merchant's stores"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Serves the OpenAPI contract. This is the single source of truth for\nclients: the platform generates its API client from it (see\ntuma-docs/Tuma_API_Architecture.md), the mobile client is written\nagainst it by hand.",
        "operationId": "openapi_json",
        "responses": {
          "200": {
            "description": "OpenAPI contract for the Tuma API",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/stores": {
      "get": {
        "tags": [
          "stores"
        ],
        "operationId": "list_stores",
        "responses": {
          "200": {
            "description": "Open stores, oldest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StoreResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not a customer"
          }
        }
      }
    },
    "/v1/stores/{id}": {
      "get": {
        "tags": [
          "stores"
        ],
        "operationId": "get_store",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Store id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The store and its available products",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreWithProductsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not a customer"
          },
          "404": {
            "description": "No open store with that id"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminStoreResponse": {
        "type": "object",
        "description": "A store inside the admin's merchant detail — standing facts plus how\nmany products it has. No location or image until something displays them.",
        "required": [
          "id",
          "name",
          "delivery_fee",
          "is_open",
          "product_count",
          "created_at"
        ],
        "properties": {
          "address_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "delivery_fee": {
            "type": "integer",
            "format": "int64"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "is_open": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
