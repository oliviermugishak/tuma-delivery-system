# Runtime environment
APP_ENV=local

# Server
TUMA_CORS_ORIGIN=http://localhost:3000

# Application
APP_APPLICATION__HOST=127.0.0.1
APP_APPLICATION__PORT=8080
APP_APPLICATION__COOKIE_SECURE=false
# Serve the built frontend from this directory (SPA fallback). Leave unset
# locally. The Docker image sets it via ENV when it exists.
# APP_APPLICATION__STATIC_DIR=

# Database (either the individual fields below, or a single DATABASE_URL —
# when DATABASE_URL is set it wins over every APP_DATABASE__* field)
# DATABASE_URL=postgres://postgres:password123@localhost:5432/tuma
APP_DATABASE__HOST=localhost
APP_DATABASE__USERNAME=postgres
APP_DATABASE__PASSWORD=password123
APP_DATABASE__PORT=5432
APP_DATABASE__DATABASE_NAME=tuma
APP_DATABASE__REQUIRE_SSL=false

# Secrets
APP_SECRET__JWT_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Google Maps Platform — both keys are SERVER-SIDE only; no key ever
# reaches a client. Get them from console.cloud.google.com (same project
# is fine: one key may serve several APIs, or make one key per API and
# restrict each in the console to exactly its API).
#
#   Directions key  → enable "Directions API"
#   Geocoding key   → enable "Geocoding API"   (⚠ not "Geolocation API")
# ---------------------------------------------------------------------------

# Road routing (tracking doc §4): the server calls Google Directions once
# per handoff to cache the road route + ETA. The key NEVER leaves the
# server. BACKEND must be `google` for the key to be used — with `google`
# and an empty key the server REFUSES to start (a misconfig must surface,
# never silently degrade). Leave BACKEND unset while you have no key.
APP_ROUTING__BACKEND=google
APP_ROUTING__API_KEY=
# APP_ROUTING__REGION=rw   # optional country bias — omit for a fully multinational deployment

# Reverse geocoding (geocoding-rebuild slice): when an address or a store
# is saved WITH a pin, the server derives its display name from the pin
# ("KN 5 Rd, Kigali") and caches it in `geocoding.cache` — the same place
# is never billed twice. Nobody types address text anywhere in the
# product; the pin is the truth and the text is what the geocoder says.
#
#   BACKEND=google  → derive with Google (needs the key: enable
#                     "Geocoding API", ⚠ NOT "Geolocation API")
#   BACKEND=none    → no derivation; saves still land and the display
#                     text falls back to the label word (never coordinates)
#   REGION          → optional country bias for better matches (e.g. rw).
#                     Leave unset for a fully multinational system.
APP_GEOCODING__BACKEND=google
APP_GEOCODING__API_KEY=
# APP_GEOCODING__REGION=rw
