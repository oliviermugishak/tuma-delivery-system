  "query": "\n        UPDATE commerce.payments p\n        SET status = $2\n        WHERE p.status = $3\n          AND p.id = (\n            SELECT a.payment_id FROM commerce.payment_allocations a\n            WHERE a.store_order_id = $1\n          )\n          AND NOT EXISTS (\n            SELECT 1 FROM commerce.payment_allocations a2\n            WHERE a2.payment_id = p.id AND a2.status = $4\n          )\n        ",
