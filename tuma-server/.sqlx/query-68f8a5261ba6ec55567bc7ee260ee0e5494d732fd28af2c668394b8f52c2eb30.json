  "query": "\n        SELECT sp.id, sp.store_id, s.merchant_id, sp.product_id,\n               sp.price, sp.stock, sp.is_available, sp.sku\n        FROM marketplace.store_products sp\n        JOIN marketplace.stores s ON s.id = sp.store_id\n        WHERE sp.id = $1\n        ",
