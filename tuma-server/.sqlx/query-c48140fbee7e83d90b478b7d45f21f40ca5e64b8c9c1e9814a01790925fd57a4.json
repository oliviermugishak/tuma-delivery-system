  "db_name": "PostgreSQL",
  "query": "\n        SELECT s.id, s.name, s.address_text, s.delivery_fee, s.is_open,\n               s.created_at, COUNT(p.id) as \"product_count!\"\n        FROM tuma.stores s\n        LEFT JOIN tuma.products p ON p.store_id = s.id\n        WHERE s.merchant_id = $1\n        GROUP BY s.id\n        ORDER BY s.created_at\n        ",
